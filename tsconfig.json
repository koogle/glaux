{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",        // 👈︎ required when using NodeNext resolution
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
